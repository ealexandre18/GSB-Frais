{% extends "PgGsbFraisBundle::accueil.html.twig" %}

{% block bloc1 %}
<div id="contenu">
    <h2>Validation des fiches de frais visiteurs</h2>

    {% if message %}
        <div style="padding: 10px 15px; margin-bottom: 15px; border-radius: 4px; font-weight: bold;
            {% if messageType == 'success' %} background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb;
            {% elseif messageType == 'error' %} background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;
            {% elseif messageType == 'warning' %} background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba;
            {% else %} background-color: #d1ecf1; color: #0c5460; border: 1px solid #bee5eb; {% endif %}">
            {{ message }}
        </div>
    {% endif %}

    <!-- 1. Formulaire de sélection du Visiteur et du Mois -->
    <form action="{{ path('pg_gsb_frais_validerfrais') }}" method="GET">
        <input type="hidden" name="route" value="validerfrais" />
        <div class="corpsForm">
            <fieldset>
                <legend>Choisir le visiteur et le mois à valider</legend>
                <p>
                    <label for="lstVisiteur">Visiteur médical : </label>
                    <select id="lstVisiteur" name="lstVisiteur" style="width: 250px; padding: 4px;">
                        <option value="">-- Sélectionner un visiteur --</option>
                        {% for unVisiteur in lesvisiteurs %}
                            <option value="{{ unVisiteur.id }}" {% if unVisiteur.id == idvisiteur %}selected{% endif %}>
                                {{ unVisiteur.nom }} {{ unVisiteur.prenom }} ({{ unVisiteur.id }})
                            </option>
                        {% endfor %}
                    </select>
                </p>
                <p>
                    <label for="lstMois">Mois : </label>
                    <select id="lstMois" name="lstMois" style="width: 180px; padding: 4px;">
                        {% for unMois in lesmois %}
                            <option value="{{ unMois.mois }}" {% if unMois.mois == lemois %}selected{% endif %}>
                                {{ unMois.numMois }}/{{ unMois.numAnnee }}
                            </option>
                        {% endfor %}
                    </select>
                </p>
            </fieldset>
        </div>
        <div class="piedForm">
            <p>
                <input id="ok" type="submit" value="Valider" size="20" />
                <input id="annuler" type="reset" value="Effacer" size="20" />
            </p> 
        </div>
    </form>

    {% if ficheExiste %}
        <hr style="margin: 25px 0; border: 0; border-top: 2px solid #0055A5;" />
        
        <h3>Fiche de frais de {{ visiteurInfo.prenom }} {{ visiteurInfo.nom }} - Mois : {{ lemois|slice(4,2) }}/{{ lemois|slice(0,4) }}</h3>
        <p style="font-weight: bold; color: #333;">
            État actuel de la fiche : <span style="color: #0055A5;">{{ ficheinfo.libetat }}</span> (Dernière modif : {{ ficheinfo.datemodif }})
        </p>

        <!-- 2. Formulaire des Frais Forfaitisés (Actualisation) -->
        <form action="{{ path('pg_gsb_frais_validerfrais') }}" method="POST">
            <input type="hidden" name="lstVisiteur" value="{{ idvisiteur }}" />
            <input type="hidden" name="lstMois" value="{{ lemois }}" />
            <input type="hidden" name="action" value="actualiserForfait" />
            
            <div class="corpsForm">
                <fieldset>
                    <legend>Éléments forfaitisés</legend>
                    {% for unfrais in lesfraisforfait %}
                        {% set idfrais = unfrais.idfrais|trim %}
                        {% set libelle = unfrais.libelle %}
                        {% set quantite = unfrais.quantite %}
                        <p>
                            <label for="idFrais_{{ idfrais }}">
                                {% if idfrais == 'KM' %}
                                    Frais Kilométrique (en km)
                                    {% if unVehicule is defined and unVehicule %}
                                        <small style="color: #0055A5;">({{ unVehicule.carburant }} {{ unVehicule.puissance }} - {{ unVehicule.montant_km }} €/km)</small>
                                    {% endif %}
                                {% elseif idfrais == 'ETP' %}
                                    Forfait Étape (nombre de soirées étapes)
                                {% elseif idfrais == 'NUI' %}
                                    Nuitée Hôtel (nombre de nuits)
                                {% elseif idfrais == 'REP' %}
                                    Repas Restaurant (nombre de repas)
                                {% else %}
                                    {{ libelle }} (quantité)
                                {% endif %}
                            </label>
                            <input type="text" id="idFrais_{{ idfrais }}" name="lesFrais[{{ idfrais }}]" size="10" maxlength="5" value="{{ quantite }}" />
                        </p>
                    {% endfor %}
                </fieldset>
            </div>
            <div class="piedForm">
                <p>
                    <input type="submit" value="Actualiser les forfaits" style="background-color: #0055A5; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;" />
                    <input type="reset" value="Réinitialiser" />
                </p>
            </div>
        </form>

        <!-- 3. Tableau des Frais Hors Forfait (Refuser / Reporter) -->
        <div style="margin-top: 25px;">
            <table class="listeLegere">
                <caption>Descriptif des éléments hors forfait</caption>
                <tr>
                    <th class="date">Date</th>
                    <th class="libelle">Libellé</th>
                    <th class="montant">Montant (€)</th>
                    <th class="statut">Statut</th>
                    <th class="justificatif">Justificatif</th>
                    <th class="action" colspan="2">Actions Comptable</th>
                </tr>
                {% if lesfraishorsforfait|length > 0 %}
                    {% for unfrais in lesfraishorsforfait %}
                        {% set idfrais = unfrais.id %}
                        {% set date = unfrais.date %}
                        {% set libelle = unfrais.libelle %}
                        {% set montant = unfrais.montant %}
                        {% set justificatif = unfrais.justificatif_url|default(null) %}
                        {% set estRefuse = libelle starts with 'REFUSE :' %}
                        
                        <tr {% if estRefuse %}style="background-color: #f8d7da; text-decoration: line-through; color: #721c24;"{% endif %}>
                            <td>{{ date }}</td>
                            <td>{{ libelle }}</td>
                            <td>{{ montant }} €</td>
                            <td>
                                {% if estRefuse %}
                                    <span style="background-color: #f8d7da; color: #721c24; padding: 2px 6px; border-radius: 3px; font-weight: bold; font-size: 11px;">🔴 Refusé</span>
                                {% elseif ficheinfo.idetat == 'VA' or ficheinfo.idetat == 'RB' %}
                                    <span style="background-color: #d4edda; color: #155724; padding: 2px 6px; border-radius: 3px; font-weight: bold; font-size: 11px;">🟢 Validé</span>
                                {% else %}
                                    <span style="background-color: #fff3cd; color: #856404; padding: 2px 6px; border-radius: 3px; font-weight: bold; font-size: 11px;">🟡 En attente</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if justificatif %}
                                    <a href="{{ asset('uploads/justificatifs/' ~ justificatif) }}" target="_blank" title="Voir la pièce jointe">📄 Voir</a>
                                {% else %}
                                    <span style="color: #888;">Aucun</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if not estRefuse %}
                                    <form action="{{ path('pg_gsb_frais_validerfrais') }}" method="POST" style="display:inline;" onsubmit="return confirm('Confirmer le refus de ce frais ?');">
                                        <input type="hidden" name="lstVisiteur" value="{{ idvisiteur }}" />
                                        <input type="hidden" name="lstMois" value="{{ lemois }}" />
                                        <input type="hidden" name="idFraisHF" value="{{ idfrais }}" />
                                        <input type="hidden" name="action" value="refuserHF" />
                                        <input type="submit" value="❌ Refuser" style="background-color: #dc3545; color: white; border: none; padding: 4px 8px; border-radius: 3px; cursor: pointer; font-size: 11px;" />
                                    </form>
                                {% else %}
                                    <span style="font-weight: bold; color: #dc3545; font-size: 11px;">Refusé</span>
                                {% endif %}
                            </td>
                            <td>
                                <form action="{{ path('pg_gsb_frais_validerfrais') }}" method="POST" style="display:inline;" onsubmit="return confirm('Reporter ce frais au mois suivant ?');">
                                    <input type="hidden" name="lstVisiteur" value="{{ idvisiteur }}" />
                                    <input type="hidden" name="lstMois" value="{{ lemois }}" />
                                    <input type="hidden" name="idFraisHF" value="{{ idfrais }}" />
                                    <input type="hidden" name="action" value="reporterHF" />
                                    <input type="submit" value="🔁 Reporter" style="background-color: #ffc107; color: black; border: none; padding: 4px 8px; border-radius: 3px; cursor: pointer; font-size: 11px;" />
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="7" style="text-align: center; color: #888;">Aucun frais hors forfait pour ce mois.</td>
                    </tr>
                {% endif %}
            </table>
        </div>

        <!-- 4. Validation finale de la fiche de frais -->
        <form action="{{ path('pg_gsb_frais_validerfrais') }}" method="POST" style="margin-top: 25px;" onsubmit="return confirm('Voulez-vous vraiment valider cette fiche de frais ? Elle passera à l\'état Validée.');">
            <input type="hidden" name="lstVisiteur" value="{{ idvisiteur }}" />
            <input type="hidden" name="lstMois" value="{{ lemois }}" />
            <input type="hidden" name="action" value="validerFicheFinale" />
            
            <div class="corpsForm">
                <fieldset>
                    <legend>Validation et clôture du remboursement</legend>
                    <p>
                        <label for="nbJustificatifs">Nombre de justificatifs reçus : </label>
                        <input type="text" id="nbJustificatifs" name="nbJustificatifs" size="5" maxlength="3" value="{{ ficheinfo.nbjustificatifs|default('0') }}" />
                    </p>
                </fieldset>
            </div>
            <div class="piedForm">
                <p>
                    <input type="submit" value="✅ Valider la fiche de frais" style="background-color: #28a745; color: white; font-weight: bold; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-size: 13px;" />
                </p>
            </div>
        </form>
    {% endif %}
</div>
{% endblock %}
