<table class="listeLegere">
   <caption>Descriptif des éléments hors forfait - {{ nbjustificatifs }} justificatif(s) reçu(s) -</caption>
   <tr>
      <th class="date">Date</th>
      <th class="libelle">Libellé</th>
      <th class="montant">Montant (€)</th>
      <th class="statut">Statut</th>
      <th class="justificatif">Justificatif</th>
   </tr>
   {% for unFrais in lesfraishorsforfait %}
      {% set date = unFrais.date %}
      {% set libelle = unFrais.libelle %}
      {% set montant = unFrais.montant %}
      {% set justificatif = unFrais.justificatif_url|default(null) %}
      {% set estRefuse = libelle starts with 'REFUSE :' or unFrais.statut|default('') == 'Refusé' %}
      <tr {% if estRefuse %}style="background-color: #f8d7da; color: #721c24;"{% endif %}>
          <td>{{ date }}</td>
          <td>{{ libelle }}</td>
          <td>{{ montant }} €</td>
          <td>
             {% if estRefuse %}
                <span style="background-color: #f8d7da; color: #721c24; padding: 2px 6px; border-radius: 3px; font-weight: bold; font-size: 11px;">🔴 Refusé</span>
             {% elseif libetat is defined and (libetat == 'Validée' or libetat == 'Remboursée' or libetat == 'VA' or libetat == 'RB') %}
                <span style="background-color: #d4edda; color: #155724; padding: 2px 6px; border-radius: 3px; font-weight: bold; font-size: 11px;">🟢 Validé</span>
             {% else %}
                <span style="background-color: #fff3cd; color: #856404; padding: 2px 6px; border-radius: 3px; font-weight: bold; font-size: 11px;">🟡 En attente</span>
             {% endif %}
          </td>
          <td>
              {% if justificatif %}
                  <a href="{{ asset('uploads/justificatifs/' ~ justificatif) }}" target="_blank" title="Voir le justificatif">📄 Voir</a>
              {% else %}
                  <span style="color: #888;">Aucun</span>
              {% endif %}
          </td>
      </tr>
   {% endfor %}
</table>